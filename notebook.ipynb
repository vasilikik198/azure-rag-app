"cell_type": "markdown",
"metadata": {},
"source": [
"# Azure RAG & Vector Database Debugging Notebook\n",
"\n",
"This notebook contains the decoupled functions from the Flask backend to help you test, step through, and debug the RAG pipeline step-by-step using Python."
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 1. Imports & Configuration\n",
"Set your environment variables or direct keys here for Azure OpenAI."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"import os\n",
"import json\n",
"import re\n",
"import numpy as np\n",
"import pandas as pd\n",
"from sklearn.metrics.pairwise import cosine_similarity\n",
"from openai import AzureOpenAI\n",
"\n",
"# Set or override environment variables for debugging\n",
"AZURE_OPENAI_API_KEY = os.environ.get("AZURE_OPENAI_API_KEY", "your-azure-api-key")\n",
"AZURE_OPENAI_ENDPOINT = os.environ.get("AZURE_OPENAI_ENDPOINT", "https://your-resource-name.openai.azure.com/")\n",
"AZURE_DEPLOYMENT_NAME = os.environ.get("AZURE_DEPLOYMENT_NAME", "gpt-4o")\n",
"AZURE_EMBEDDING_DEPLOYMENT = os.environ.get("AZURE_EMBEDDING_DEPLOYMENT", "text-embedding-3-small")\n",
"\n",
"# Initialize Azure Client\n",
"client = AzureOpenAI(\n",
"    api_key=AZURE_OPENAI_API_KEY,\n",
"    api_version="2024-02-01",\n",
"    azure_endpoint=AZURE_OPENAI_ENDPOINT\n",
")\n",
"print("Azure Client Initialized successfully!")"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 2. Helper Functions (Document Processing & Embeddings)"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"def load_docs_from_jsonl(file_path):\n",
"    """Loads document records as standard dictionaries from a jsonl file."""\n",
"    array = []\n",
"    if not os.path.exists(file_path):\n",
"        print(f"Warning: File {file_path} not found.")\n",
"        return array\n",
"    with open(file_path, 'r', encoding='utf-8') as jsonl_file:\n",
"        for line in jsonl_file:\n",
"            data = json.loads(line)\n",
"            array.append(data)\n",
"    return array\n",
"\n",
"def clean_text(text):\n",
"    """Cleans input text by removing extra whitespaces."""\n",
"    if not isinstance(text, str):\n",
"        return ""\n",
"    return re.sub(r'\s+', ' ', text).strip()\n",
"\n",
"def get_embedding(text):\n",
"    """Generates embedding vector using Azure OpenAI embedding deployment."""\n",
"    response = client.embeddings.create(\n",
"        input=[text],\n",
"        model=AZURE_EMBEDDING_DEPLOYMENT\n",
"    )\n",
"    return response.data[0].embedding"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 3. Test Loading Data & Building DataFrame\n",
"Verify that scraped_data.jsonl is parsed correctly into a Pandas DataFrame."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"DATA_FILE = 'scraped_data.jsonl'\n",
"raw_docs = load_docs_from_jsonl(DATA_FILE)\n",
"print(f"Loaded {len(raw_docs)} raw documents.")\n",
"\n",
"# Convert to DataFrame\n",
"df_data = []\n",
"for doc in raw_docs:\n",
"    metadata = doc.get("metadata", {})\n",
"    df_data.append({\n",
"        "title": metadata.get("title", "No Title"),\n",
"        "source": metadata.get("source", ""),\n",
"        "content": clean_text(doc.get("page_content", ""))\n",
"    })\n",
"\n",
"df = pd.DataFrame(df_data)\n",
"print("DataFrame Shape:", df.shape)\n",
"df.head()"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 4. Compute Embeddings\n",
"Compute vector embeddings for documents in the DataFrame."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"if not df.empty and 'embedding' not in df.columns:\n",
"    print("Generating embeddings...")\n",
"    df['embedding'] = df['content'].apply(lambda x: get_embedding(x[:2000]))\n",
"    print("Embeddings computed successfully.")\n",
"\n",
"print("Sample vector length:", len(df['embedding'].iloc[0]) if not df.empty else 0)"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 5. Test Retrieval Function (Cosine Similarity)\n",
"Test search and verify top matching document snippets."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"def retrieve_top_k(query, k=3):\n",
"    """Retrieves top-k relevant documents using scikit-learn cosine similarity."""\n",
"    if df.empty or 'embedding' not in df.columns:\n",
"        return []\n",
"    \n",
"    query_embedding = get_embedding(query)\n",
"    doc_embeddings = np.vstack(df['embedding'].values)\n",
"    similarities = cosine_similarity([query_embedding], doc_embeddings)[0]\n",
"    \n",
"    top_indices = similarities.argsort()[-k:][::-1]\n",
"    \n",
"    results = []\n",
"    for idx in top_indices:\n",
"        results.append({\n",
"            "title": df.iloc[idx]['title'],\n",
"            "source": df.iloc[idx]['source'],\n",
"            "content": df.iloc[idx]['content'][:1000],\n",
"            "score": float(similarities[idx])\n",
"        })\n",
"    return results\n",
"\n",
"# Test Retrieval\n",
"test_query = "What is the main topic of the dataset?"\n",
"retrieved_results = retrieve_top_k(test_query, k=3)\n",
"print(f"Retrieved {len(retrieved_results)} results for query: '{test_query}'\n")\n",
"\n",
"for i, res in enumerate(retrieved_results):\n",
"    print(f"--- Result {i+1} (Score: {res['score']:.4f}) ---")\n",
"    print(f"Title: {res['title']}")\n",
"    print(f"Source: {res['source']}")\n",
"    print(f"Snippet: {res['content'][:200]}...\n")"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 6. End-to-End RAG Query Test\n",
"Test full RAG generation output using Azure OpenAI Chat Completions."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"def ask_rag(query):\n",
"    """Executes full RAG workflow for debugging."""\n",
"    docs = retrieve_top_k(query, k=3)\n",
"    context_text = "\n\n".join([f"Source: {d['source']}\nContent: {d['content']}" for d in docs])\n",
"    \n",
"    prompt = f"""You are a helpful assistant. Use the following context pieces to answer the user's question accurately. If you don't know the answer based on the context, state that you don't know.\n",
"\n",
"Context:\n",
"{context_text}\n",
"\n",
"Question: {query}\n",
"Answer:"""\n",
"    \n",
"    response = client.chat.completions.create(\n",
"        model=AZURE_DEPLOYMENT_NAME,\n",
"        messages=[\n",
"            {"role": "system", "content": "You are an expert AI assistant answering questions based on provided documentation."},\n",
"            {"role": "user", "content": prompt}\n",
"        ],\n",
"        temperature=0.3\n",
"    )\n",
"    return response.choices[0].message.content, docs\n",
"\n",
"# Run Test\n",
"sample_user_question = "Summarize the key information available."\n",
"answer, sources = ask_rag(sample_user_question)\n",
"\n",
"print("=== GENERATED ANSWER =")\n",
"print(answer)\n",
"print("\n= SOURCES USED ===")\n",
"for s in sources:\n",
"    print(f"- {s['title']} ({s['source']})")"
]
}
],
